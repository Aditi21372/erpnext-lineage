# Copy to .env, fill in what you need, then apply with:  docker compose up -d
# (recreates the container with the new environment; your data volume is kept).
# NEVER commit .env — it is gitignored.

# --- LLM for the chat agent (optional; without it the deterministic router answers)
# Recommended + tested: OpenCode Go (OpenAI-compatible gateway).
#   1. subscribe to Go / Go Plus at https://opencode.ai
#   2. copy your API key (starts with oc_sk_)
#   3. fill the three variables below
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-v4.1-flash
# Any other OpenAI-compatible endpoint works the same way
# (OpenAI, Azure OpenAI, Ollama, vLLM, LM Studio, ...): set its base URL,
# key and model id. Omit the key to run in router mode.

# Optional routing/session id sent as x-opencode-session (any stable string):
#OPENAI_SESSION=

# --- deployment
# Host port (container always listens on 8765):
#LINEAGE_PORT=8765

# Re-fetch sources + rebuild the graph on next start:
#REBUILD=1

# Source pin overrides (defaults: frappe_docker 2b26e9a, erpnext 7474d9e = v16.50.0):
#FRAPPE_DOCKER_COMMIT=
#ERPNEXT_COMMIT=
